# EcoSphere ESG Backend Configuration Settings

# MongoDB connection string URI (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ecosphere?retryWrites=true&w=majority

# Secret key for JWT signing & verification (Required, min 10 chars)
JWT_SECRET=supersecretchangeinproductionwithlongrandomstring

# JWT expiration duration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Network port for HTTP Express server to listen on
PORT=5000

# Client origin URL allowed for CORS access
VITE_FRONTEND_URL=http://localhost:5173

# Seeding trigger flag (Set 'true' to reset database and insert mock data)
SEED_RESET=false

# Node environment state (development / production / test)
NODE_ENV=development
